# Comma-separated ADS-B API base URLs, highest priority first.
# Both return the readsb-style /v2/point/{lat}/{lon}/{radiusNm} format.
ADS_SOURCES=https://api.adsb.lol/v2/point

# How often each active grid cell is polled (ms).
POLL_INTERVAL_MS=1000

# Minimum gap between any two upstream ADS-B requests (ms). Keep this at or
# above your provider's rate limit.
ADS_REQUEST_GAP_MS=1100

# Upper bound on the radius a client may request (km).
MAX_RADIUS_KM=500

# Public URL the browser uses to reach the backend (baked into the frontend build).
VITE_BACKEND_URL=http://localhost:3001

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=3001
